# Cloud Operation Agent - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ─── LLM Configuration ──────────────────────────────────────────────────
# Groq API Key for LLM
GROQ_API_KEY=your_groq_api_key_here

# ─── Google Sheets Configuration ────────────────────────────────────────
# Google Sheets ID (extracted from sheet URL)
# Example: https://docs.google.com/spreadsheets/d/{GOOGLE_SHEETS_ID}/edit
GOOGLE_SHEETS_ID=your_sheet_id_here

# Path to Google Service Account credentials (for Cloud Cost queries)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ─── Grafana Configuration ─────────────────────────────────────────────
# Grafana API Token (Bearer token for authentication)
MCP_GRAFANA_TOKEN=your_grafana_bearer_token_here

# Grafana URL (for local development or remote)
GRAFANA_URL=http://localhost:3000

# ─── Prometheus Configuration ──────────────────────────────────────────
# Prometheus URL (usually co-located with Grafana)
PROMETHEUS_URL=http://localhost:9090

# ─── Application Settings ──────────────────────────────────────────────
# Streamlit configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Deployment environment
DEPLOYMENT_ENV=development  # development, staging, or production

# ─── Logging Configuration ─────────────────────────────────────────────
# Log level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ─── Optional: Slack Notifications ────────────────────────────────────
# Slack webhook for deployment notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── Optional: Database Configuration ──────────────────────────────────
# If using external database for session storage
DATABASE_URL=sqlite:///app.db

# ─── Docker Configuration ──────────────────────────────────────────────
# Docker-specific environment variables
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
